# Express API Configuration (apps/api)

# Server Port and Environment
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# PostgreSQL Connection String (Prisma ORM)
DATABASE_URL=postgresql://aven_user:aven_password@localhost:5432/aven_db?schema=public

# Authentication Secrets
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here
JWT_EXPIRES_IN=15m

# Public API Rate Limits (per client IP)
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
LOGIN_RATE_LIMIT_MAX_REQUESTS=10
PUBLIC_RATE_LIMIT_WINDOW_MINUTES=1
PUBLIC_RATE_LIMIT_MAX_REQUESTS=60

# AI Advisory Service URL (apps/ai)
AI_SERVICE_URL=http://localhost:8000
AI_INTERNAL_TOKEN=replace_with_a_random_secret_at_least_32_characters

# Local SeaweedFS (S3-compatible, synthetic data only)
S3_ENDPOINT=http://localhost:9000
S3_PORT=9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=aven-documents
S3_USE_SSL=false

# Worker Queue Configuration
JOB_LEASE_DURATION_SECONDS=60
JOB_MAX_RETRIES=3

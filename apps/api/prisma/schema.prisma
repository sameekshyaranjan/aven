// Prisma Schema for Aven Core API
// Sole Write Authority over PostgreSQL (PRD §5.1)

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum UserRole {
  HOSPITAL_DESK
  INSURER_REVIEWER
  ADMIN
  PATIENT
}

enum PolicyVersionStatus {
  ACTIVE
}

enum AddonVersionStatus {
  ACTIVE
}

enum PolicyRuleType {
  WAITING_PERIOD
  CHECKLIST_APPLICABILITY
  ADDON_PRECEDENCE
}

enum MemberRelationship {
  SELF
  SPOUSE
  CHILD
  PARENT
  OTHER
}

enum ClaimStatus {
  DRAFT
  SUBMITTED
  ANALYSING
  NEEDS_INFORMATION
  READY_FOR_REVIEW
  UNDER_REVIEW
  APPROVED
  PARTIALLY_APPROVED
  REFUSAL_PENDING
  REFUSED
  CLOSED
}

enum ReviewActionKind {
  NOTE
  CONFIRM
  FLAG
}

enum InformationRequestStatus {
  OPEN
  RESPONSE_RECEIVED
}

enum DocumentType {
  PREAUTH_FORM
  MEMBER_PROOF
  CLINICAL_NOTE
  INVESTIGATION_REPORT
  TREATMENT_PLAN
  ESTIMATE
  CONSENT
  OTHER
}

enum DocumentProcessingStatus {
  UPLOADED
  VALIDATING
  READY
  ANALYSING
  ANALYSED
  UNREADABLE
  FAILED
}

enum AiJobKind {
  CLAIM_ANALYSIS
}

enum AiJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
  MANUAL_REVIEW
  SUPERSEDED
}

enum AiAttemptStatus {
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
  EXPIRED
}

model Hospital {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  rohiniId  String?  @unique
  city      String
  state     String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          User[]
  policyProducts PolicyProduct[] @relation("PolicyProductInsurer")
  addonVersions  AddonVersion[]  @relation("AddonVersionInsurer")
  claims         Claim[]

  @@index([isActive])
  @@map("hospitals")
}

model User {
  id                   String                @id @default(uuid()) @db.Uuid
  email                String                @unique
  name                 String
  role                 UserRole
  hospitalId           String?               @db.Uuid
  hospital             Hospital?             @relation(fields: [hospitalId], references: [id], onDelete: SetNull)
  isActive             Boolean               @default(true)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  claimEvents          ClaimEvent[]
  documentVersions     DocumentVersion[]
  reviewActions        ReviewAction[]
  informationRequests  InformationRequest[]
  informationResponses InformationResponse[]
  notifications        Notification[]

  @@index([role])
  @@index([hospitalId])
  @@index([isActive])
  @@map("users")
}

model PolicyProduct {
  id        String   @id @default(uuid()) @db.Uuid
  insurerId String   @db.Uuid
  code      String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  insurer  Hospital        @relation("PolicyProductInsurer", fields: [insurerId], references: [id], onDelete: Restrict)
  versions PolicyVersion[]

  @@unique([insurerId, code])
  @@index([insurerId])
  @@map("policy_products")
}

model PolicyVersion {
  id              String              @id @default(uuid()) @db.Uuid
  policyProductId String              @db.Uuid
  versionNumber   Int
  status          PolicyVersionStatus @default(ACTIVE)
  createdAt       DateTime            @default(now())

  policyProduct    PolicyProduct              @relation(fields: [policyProductId], references: [id], onDelete: Restrict)
  compatibleAddons PolicyAddonCompatibility[]
  clauses          PolicyClause[]
  rules            PolicyRuleVersion[]
  enrollments      PolicyEnrollment[]
  aiJobs           AiJob[]

  @@unique([policyProductId, versionNumber])
  @@index([policyProductId, status])
  @@map("policy_versions")
}

model PolicyEnrollment {
  id              String   @id @default(uuid()) @db.Uuid
  policyNumber    String   @unique
  policyVersionId String   @db.Uuid
  coverageStart   DateTime @db.Date
  coverageEnd     DateTime @db.Date
  createdAt       DateTime @default(now())

  policyVersion  PolicyVersion           @relation(fields: [policyVersionId], references: [id], onDelete: Restrict)
  members        Member[]
  selectedAddons PolicyEnrollmentAddon[]
  claims         Claim[]

  @@index([policyVersionId, coverageStart, coverageEnd])
  @@map("policy_enrollments")
}

model Member {
  id             String             @id @default(uuid()) @db.Uuid
  enrollmentId   String             @db.Uuid
  memberCode     String
  fullName       String
  dateOfBirth    DateTime           @db.Date
  relationship   MemberRelationship
  isPolicyholder Boolean            @default(false)
  createdAt      DateTime           @default(now())

  enrollment PolicyEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  claims     Claim[]

  @@unique([enrollmentId, memberCode])
  @@index([enrollmentId])
  @@map("members")
}

model Claim {
  id                  String      @id @default(uuid()) @db.Uuid
  hospitalId          String      @db.Uuid
  enrollmentId        String      @db.Uuid
  memberId            String      @db.Uuid
  status              ClaimStatus @default(DRAFT)
  version             Int         @default(1)
  currentRevision     Int         @default(1)
  originalReceiptAt   DateTime?
  emergencyReason     String?     @db.VarChar(500)
  missingAtSubmission Json?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  hospital            Hospital             @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  enrollment          PolicyEnrollment     @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  member              Member               @relation(fields: [memberId], references: [id], onDelete: Restrict)
  revisions           ClaimRevision[]
  events              ClaimEvent[]
  documents           Document[]
  reviewActions       ReviewAction[]
  informationRequests InformationRequest[]
  notifications       Notification[]
  aiJobs              AiJob[]

  @@index([hospitalId, status, updatedAt])
  @@index([enrollmentId])
  @@map("claims")
}

model ReviewAction {
  id          String           @id @default(uuid()) @db.Uuid
  claimId     String           @db.Uuid
  actorUserId String           @db.Uuid
  kind        ReviewActionKind
  fieldKey    String?          @db.VarChar(100)
  text        String           @db.VarChar(1000)
  createdAt   DateTime         @default(now())

  claim Claim @relation(fields: [claimId], references: [id], onDelete: Restrict)
  actor User  @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([claimId, createdAt])
  @@map("review_actions")
}

model InformationRequest {
  id                String                   @id @default(uuid()) @db.Uuid
  claimId           String                   @db.Uuid
  reviewerUserId    String                   @db.Uuid
  status            InformationRequestStatus @default(OPEN)
  items             Json
  publishedRevision Int
  createdAt         DateTime                 @default(now())
  response          InformationResponse?

  claim    Claim @relation(fields: [claimId], references: [id], onDelete: Restrict)
  reviewer User  @relation(fields: [reviewerUserId], references: [id], onDelete: Restrict)

  @@index([claimId, status, createdAt])
  @@map("information_requests")
}

model InformationResponse {
  id             String   @id @default(uuid()) @db.Uuid
  requestId      String   @unique @db.Uuid
  hospitalUserId String   @db.Uuid
  answers        Json
  documentIds    Json
  createdAt      DateTime @default(now())

  request      InformationRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  hospitalUser User               @relation(fields: [hospitalUserId], references: [id], onDelete: Restrict)

  @@map("information_responses")
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  claimId   String    @db.Uuid
  title     String    @db.VarChar(160)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Restrict)
  claim Claim @relation(fields: [claimId], references: [id], onDelete: Restrict)

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

model Document {
  id             String       @id @default(uuid()) @db.Uuid
  claimId        String       @db.Uuid
  type           DocumentType
  currentVersion Int          @default(1)
  createdAt      DateTime     @default(now())

  claim    Claim             @relation(fields: [claimId], references: [id], onDelete: Restrict)
  versions DocumentVersion[]

  @@index([claimId, createdAt])
  @@map("documents")
}

model DocumentVersion {
  id                String                   @id @default(uuid()) @db.Uuid
  documentId        String                   @db.Uuid
  version           Int
  objectKey         String                   @unique
  sha256            String                   @db.VarChar(64)
  sizeBytes         Int
  mediaType         String                   @db.VarChar(100)
  processingStatus  DocumentProcessingStatus @default(READY)
  uploadedByUserId  String                   @db.Uuid
  replacementReason String?                  @db.VarChar(500)
  createdAt         DateTime                 @default(now())

  document   Document @relation(fields: [documentId], references: [id], onDelete: Restrict)
  uploadedBy User     @relation(fields: [uploadedByUserId], references: [id], onDelete: Restrict)

  @@unique([documentId, version])
  @@map("document_versions")
}

model ClaimRevision {
  id             String   @id @default(uuid()) @db.Uuid
  claimId        String   @db.Uuid
  revisionNumber Int
  intake         Json
  createdAt      DateTime @default(now())

  claim Claim @relation(fields: [claimId], references: [id], onDelete: Restrict)
  aiJobs AiJob[]

  @@unique([claimId, revisionNumber])
  @@map("claim_revisions")
}

model AiJob {
  id                String      @id @default(uuid()) @db.Uuid
  claimId           String      @db.Uuid
  claimRevisionId   String      @db.Uuid
  claimVersion      Int
  policyVersionId   String      @db.Uuid
  addonVersionIds   Json
  documentSetHash   String      @db.VarChar(64)
  kind              AiJobKind   @default(CLAIM_ANALYSIS)
  status            AiJobStatus @default(QUEUED)
  attemptGeneration Int         @default(0)
  currentStage      String?     @db.VarChar(80)
  lastErrorCode     String?     @db.VarChar(80)
  result            Json?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  claim         Claim          @relation(fields: [claimId], references: [id], onDelete: Restrict)
  claimRevision ClaimRevision  @relation(fields: [claimRevisionId], references: [id], onDelete: Restrict)
  policyVersion PolicyVersion  @relation(fields: [policyVersionId], references: [id], onDelete: Restrict)
  attempts      AiJobAttempt[]

  @@unique([claimRevisionId, kind])
  @@index([status, createdAt])
  @@index([claimId, createdAt])
  @@map("ai_jobs")
}

model AiJobAttempt {
  id             String          @id @default(uuid()) @db.Uuid
  jobId          String          @db.Uuid
  generation     Int
  status         AiAttemptStatus @default(RUNNING)
  leaseToken     String?         @unique @db.Uuid
  leaseExpiresAt DateTime?
  startedAt      DateTime        @default(now())
  finishedAt     DateTime?
  errorCode      String?         @db.VarChar(80)
  callbackHash   String?         @db.VarChar(64)

  job AiJob @relation(fields: [jobId], references: [id], onDelete: Restrict)

  @@unique([jobId, generation])
  @@map("ai_job_attempts")
}

model ClaimEvent {
  id           String       @id @default(uuid()) @db.Uuid
  claimId      String       @db.Uuid
  actorUserId  String?      @db.Uuid
  fromStatus   ClaimStatus?
  toStatus     ClaimStatus
  claimVersion Int
  reason       String?      @db.VarChar(500)
  createdAt    DateTime     @default(now())

  claim Claim @relation(fields: [claimId], references: [id], onDelete: Restrict)
  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([claimId, createdAt])
  @@map("claim_events")
}

model PolicyEnrollmentAddon {
  enrollmentId   String   @db.Uuid
  addonVersionId String   @db.Uuid
  createdAt      DateTime @default(now())

  enrollment   PolicyEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  addonVersion AddonVersion     @relation(fields: [addonVersionId], references: [id], onDelete: Restrict)

  @@id([enrollmentId, addonVersionId])
  @@index([addonVersionId])
  @@map("policy_enrollment_addons")
}

model AddonVersion {
  id            String             @id @default(uuid()) @db.Uuid
  insurerId     String             @db.Uuid
  code          String
  name          String
  versionNumber Int
  status        AddonVersionStatus @default(ACTIVE)
  createdAt     DateTime           @default(now())

  insurer              Hospital                   @relation("AddonVersionInsurer", fields: [insurerId], references: [id], onDelete: Restrict)
  compatiblePolicies   PolicyAddonCompatibility[]
  clauses              PolicyClause[]
  rules                PolicyRuleVersion[]
  enrollmentSelections PolicyEnrollmentAddon[]

  @@unique([insurerId, code, versionNumber])
  @@index([insurerId, status])
  @@map("addon_versions")
}

model PolicyAddonCompatibility {
  policyVersionId String   @db.Uuid
  addonVersionId  String   @db.Uuid
  createdAt       DateTime @default(now())

  policyVersion PolicyVersion @relation(fields: [policyVersionId], references: [id], onDelete: Restrict)
  addonVersion  AddonVersion  @relation(fields: [addonVersionId], references: [id], onDelete: Restrict)

  @@id([policyVersionId, addonVersionId])
  @@index([addonVersionId])
  @@map("policy_addon_compatibilities")
}

model PolicyClause {
  id              String   @id @default(uuid()) @db.Uuid
  policyVersionId String   @db.Uuid
  addonVersionId  String?  @db.Uuid
  clauseId        String
  versionNumber   Int
  heading         String
  text            String
  pageLabel       String
  sourceVersion   String
  createdAt       DateTime @default(now())

  policyVersion PolicyVersion      @relation(fields: [policyVersionId], references: [id], onDelete: Restrict)
  addonVersion  AddonVersion?      @relation(fields: [addonVersionId], references: [id], onDelete: Restrict)
  ruleLinks     PolicyRuleClause[]

  @@unique([clauseId, versionNumber])
  @@index([policyVersionId, addonVersionId])
  @@map("policy_clauses")
}

model PolicyRuleVersion {
  id              String         @id @default(uuid()) @db.Uuid
  policyVersionId String         @db.Uuid
  addonVersionId  String?        @db.Uuid
  ruleId          String
  versionNumber   Int
  ruleType        PolicyRuleType
  parameters      Json
  priority        Int            @default(0)
  createdAt       DateTime       @default(now())

  policyVersion PolicyVersion      @relation(fields: [policyVersionId], references: [id], onDelete: Restrict)
  addonVersion  AddonVersion?      @relation(fields: [addonVersionId], references: [id], onDelete: Restrict)
  clauseLinks   PolicyRuleClause[]

  @@unique([ruleId, versionNumber])
  @@index([policyVersionId, addonVersionId, ruleType])
  @@map("policy_rule_versions")
}

model PolicyRuleClause {
  ruleVersionId  String @db.Uuid
  policyClauseId String @db.Uuid

  ruleVersion  PolicyRuleVersion @relation(fields: [ruleVersionId], references: [id], onDelete: Restrict)
  policyClause PolicyClause      @relation(fields: [policyClauseId], references: [id], onDelete: Restrict)

  @@id([ruleVersionId, policyClauseId])
  @@index([policyClauseId])
  @@map("policy_rule_clauses")
}

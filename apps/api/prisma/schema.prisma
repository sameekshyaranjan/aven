// Prisma Schema for Aven Core API
// Sole Write Authority over PostgreSQL (PRD §5.1)

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum UserRole {
  HOSPITAL_DESK
  INSURER_REVIEWER
  ADMIN
  PATIENT
}

model Hospital {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  rohiniId  String?  @unique
  city      String
  state     String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]

  @@index([isActive])
  @@map("hospitals")
}

model User {
  id         String    @id @default(uuid()) @db.Uuid
  email      String    @unique
  name       String
  role       UserRole
  hospitalId String?   @db.Uuid
  hospital   Hospital? @relation(fields: [hospitalId], references: [id], onDelete: SetNull)
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([role])
  @@index([hospitalId])
  @@index([isActive])
  @@map("users")
}

// Prisma Schema for Aven Core API
// Sole Write Authority over PostgreSQL (PRD §5.1)

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum UserRole {
  HOSPITAL_DESK
  INSURER_REVIEWER
  ADMIN
  PATIENT
}

enum PolicyVersionStatus {
  ACTIVE
}

model Hospital {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  rohiniId  String?  @unique
  city      String
  state     String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          User[]
  policyProducts PolicyProduct[] @relation("PolicyProductInsurer")

  @@index([isActive])
  @@map("hospitals")
}

model User {
  id         String    @id @default(uuid()) @db.Uuid
  email      String    @unique
  name       String
  role       UserRole
  hospitalId String?   @db.Uuid
  hospital   Hospital? @relation(fields: [hospitalId], references: [id], onDelete: SetNull)
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([role])
  @@index([hospitalId])
  @@index([isActive])
  @@map("users")
}

model PolicyProduct {
  id        String   @id @default(uuid()) @db.Uuid
  insurerId String   @db.Uuid
  code      String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  insurer  Hospital        @relation("PolicyProductInsurer", fields: [insurerId], references: [id], onDelete: Restrict)
  versions PolicyVersion[]

  @@unique([insurerId, code])
  @@index([insurerId])
  @@map("policy_products")
}

model PolicyVersion {
  id              String              @id @default(uuid()) @db.Uuid
  policyProductId String              @db.Uuid
  versionNumber   Int
  status          PolicyVersionStatus @default(ACTIVE)
  effectiveFrom   DateTime            @db.Date
  effectiveTo     DateTime?           @db.Date
  createdAt       DateTime            @default(now())

  policyProduct PolicyProduct @relation(fields: [policyProductId], references: [id], onDelete: Restrict)

  @@unique([policyProductId, versionNumber])
  @@index([policyProductId, status, effectiveFrom, effectiveTo])
  @@map("policy_versions")
}
